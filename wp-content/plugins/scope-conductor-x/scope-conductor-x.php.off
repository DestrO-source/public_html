add_action('admin_menu',function(){
    add_options_page('Settings','Settings','manage_options','scope-conductor-x-settings',function(){
        echo '<div class="wrap"><h1>Settings</h1><form method="post" action="options.php">';
        settings_fields('scope-conductor-x_group');
        do_settings_sections('scope-conductor-x-settings');
        submit_button();
        echo '</form></div>';
    });
});
add_action('admin_init',function(){
    register_setting('scope-conductor-x_group','scope-conductor-x_options');
    add_settings_section('scope-conductor-x_main','Configuration',function(){echo '<p>Configure options below.</p>';},'scope-conductor-x-settings');
    add_settings_field('scope-conductor-x_cache','Cache Mode',function(){
        $o=get_option('scope-conductor-x_options',array());$v=isset($o['cache'])?$o['cache']:'enabled';
        echo '<select name="'.esc_attr('scope-conductor-x_options[cache]').'"><option value="enabled"'.selected($v,'enabled',false).'>Enabled</option><option value="disabled"'.selected($v,'disabled',false).'>Disabled</option></select>';
    },'scope-conductor-x-settings','scope-conductor-x_main');
});
if(function_exists('add_shortcode'))add_shortcode('scope_conductor_x_stats',function(){
    $o=get_option('scope-conductor-x_options',array());
    return '<!-- stats: '.(isset($o['cache'])?$o['cache']:'none').' -->';
});
if(function_exists('wp_normalize_path') && function_exists('register_activation_hook'))register_activation_hook(__FILE__,function(){
    if(!get_option('scope-conductor-x_options'))add_option('scope-conductor-x_options',array('cache'=>'enabled','version'=>'1.0'));
});

